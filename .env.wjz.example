# Copy this file to .env and fill in local values. Never commit .env.
OPENAI_BASE_URL=<填写兼容OpenAI格式的千问API地址>
OPENAI_API_KEY=<填写API_KEY>

# OPENAI_MODEL is a backward-compatible fallback for older code paths.
OPENAI_MODEL=qwen3.7-flash-2026-07-15
GRAPH_LLM_MODEL=qwen3.7-flash-2026-07-15
ACCURACY_JUDGE_MODEL=qwen3.7-max-2026-06-08
QUALITY_JUDGE_MODEL=qwen3.7-max-2026-06-08
STRICT_EXTRACTION_MODEL=qwen3.7-max-2026-06-08

MM_DATA_ROOT=/home/data/dataset/wjz/EvoGraph-R1
MM_DATASET=E-VQA
MM_SUBSET=<完成数据处理后填写>

MM_EMBEDDING_BACKEND=gme
MM_EMBED_MODEL_PATH=/home/data/dataset/wjz/models/gme-Qwen2-VL-2B-Instruct
MM_EMBED_DEVICE=cpu

POLICY_MODEL_PATH=/home/data/dataset/wjz/models/Qwen2.5-VL-3B-Instruct
POLICY_MODEL_NAME=Qwen2.5-VL-3B-Instruct

TEXT_SEARCH_API_URL=http://127.0.0.1:8001/search
MM_SEARCH_API_URL=http://127.0.0.1:8003/search
